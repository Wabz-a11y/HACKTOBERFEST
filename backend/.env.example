# Smart Medication Reminder - Backend Environment Variables
APP_NAME="Smart Medication Reminder API"
APP_ENV=development
PORT=8000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/smart_med_reminder
DB_NAME=smart_med_reminder

# Google AI
GOOGLE_API_KEY=your_google_ai_key_here
GEMMA_MODEL_ID=gemma-4-26b-it

# TalkSasa SMS Gateway
TALKSASA_API_KEY=your_talksasa_key_here
TALKSASA_SENDER_ID=TALKSASA
TALKSASA_API_URL=https://bulksms.talksasa.com/api/v3/sms/send
SUPPORT_PHONE=

# JWT Authentication
JWT_SECRET_KEY=change-to-a-secure-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

